# Copy to .env.local (gitignored) and uncomment what you need. An empty value counts as set, so
# leave unused variables commented out. `vercel env pull .env.local` fills the database URLs for
# the Development environment; any Postgres URL works locally.

# Pooled URL used by request handlers (Neon's PgBouncer endpoint on Vercel).
# DATABASE_URL=postgres://user:password@host/db

# Direct URL used by migrations. Falls back to DATABASE_URL.
# DATABASE_URL_UNPOOLED=postgres://user:password@host/db

# Keys the daily IP hash in rate-limit keys. Required when NODE_ENV=production; a development key
# is used otherwise.
# RATE_LIMIT_SECRET=

# Extra comma-separated origins allowed to POST. Local dev must include the Next.js dev server,
# because its /api rewrite proxies the browser's requests here with the browser's Origin header.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# `true` holds completed rounds at `complete` until `finish`. Off by default.
# CAPTCHA_ENABLED=false

# Port of the local server (src/server.ts). Defaults to 4100.
# PORT=4100
