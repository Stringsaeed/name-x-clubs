{
  "name": "web",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm i18n:compile && next dev -p 5173",
    "build": "pnpm i18n:compile && next build",
    "typecheck": "pnpm i18n:compile && next typegen && tsc --noEmit",
    "i18n:compile": "lingui compile --strict --namespace ts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "pnpm i18n:compile && vitest run",
    "test:watch": "vitest",
    "test:coverage": "pnpm i18n:compile && vitest run --coverage",
    "test:e2e": "node scripts/test-browsers.mjs",
    "check": "pnpm lint && pnpm i18n:check && pnpm test && pnpm build",
    "check:all": "pnpm check && pnpm test:e2e",
    "i18n:extract": "lingui extract --clean",
    "i18n:check": "node scripts/check-i18n.mjs",
    "assets:restore": "node scripts/sync-crests.mjs",
    "catalog:ingest": "node scripts/catalog/ingest.mjs",
    "catalog:verify": "node scripts/catalog/verify.mjs",
    "catalog:apply": "node scripts/catalog/apply.mjs",
    "start": "next start -p 5173"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@lingui/core": "6.9.1",
    "@lingui/react": "6.9.1",
    "@nxc/game": "workspace:*",
    "@tailwindcss/postcss": "4.3.3",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "lucide-react": "1.57.0",
    "motion": "14.2.0",
    "next": "16.4.0",
    "postcss": "8.5.30",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "shadcn": "4.21.5",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@lingui/cli": "6.9.1",
    "@lingui/format-po": "6.9.1",
    "@lingui/swc-plugin": "6.7.1",
    "@lingui/vite-plugin": "6.9.1",
    "@playwright/test": "1.64.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.4",
    "jsdom": "30.1.2",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "registries": {
    "@fluid": "https://www.fluidfunctionalism.com/r/{name}.json"
  }
}
