{
  "expo": {
    "name": "Name × Clubs",
    "slug": "name-x-clubs",
    "scheme": "namexclubs",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#111a16",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.stringsaeed.clubs",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.stringsaeed.clubs",
      "icon": "./assets/android-icon.png",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#123C30",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#111a16",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180
        }
      ],
      [
        "react-native-audio-api",
        {
          "iosMicrophonePermission": "Name × Clubs plays game sounds and does not record audio. The microphone is never accessed."
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "077f6bb3-eba9-4b97-8f3d-228cb0fe23f3"
      }
    },
    "owner": "stringsaeed"
  }
}
