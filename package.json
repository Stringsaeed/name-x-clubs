{
  "name": "name-x-clubs",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "pnpm i18n:compile && next dev -H 127.0.0.1 -p 5173",
    "build": "pnpm i18n:compile && next build",
    "typecheck": "pnpm i18n:compile && next typegen && tsc --noEmit",
    "i18n:compile": "lingui compile --strict --namespace ts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "pnpm i18n:compile && vitest run",
    "test:watch": "vitest",
    "test:coverage": "pnpm i18n:compile && vitest run --coverage",
    "test:e2e": "node scripts/test-browsers.mjs",
    "check": "pnpm lint && pnpm i18n:check && pnpm test && pnpm build",
    "check:all": "pnpm check && pnpm test:e2e",
    "i18n:extract": "lingui extract --clean",
    "i18n:check": "node scripts/check-i18n.mjs",
    "assets:restore": "node scripts/sync-crests.mjs",
    "start": "next start -H 127.0.0.1 -p 5173"
  },
  "dependencies": {
    "@lingui/core": "6.9.1",
    "@lingui/react": "6.9.1",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@lingui/cli": "6.9.1",
    "@lingui/format-po": "6.9.1",
    "@lingui/swc-plugin": "6.7.1",
    "@lingui/vite-plugin": "6.9.1",
    "@playwright/test": "1.64.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.4",
    "jsdom": "30.1.2",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
