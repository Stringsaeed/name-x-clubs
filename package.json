{
  "name": "name-x-clubs",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "vercel-build": "turbo run vercel-build",
    "typecheck": "turbo run typecheck",
    "i18n:compile": "turbo run i18n:compile",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "turbo run test",
    "test:watch": "pnpm --filter web test:watch",
    "test:coverage": "turbo run test:coverage",
    "test:e2e": "turbo run test:e2e",
    "check": "pnpm lint && turbo run i18n:check test build",
    "check:all": "pnpm check && pnpm test:e2e",
    "i18n:extract": "turbo run i18n:extract",
    "i18n:check": "turbo run i18n:check",
    "assets:restore": "pnpm --filter web assets:restore",
    "catalog:ingest": "pnpm --filter web catalog:ingest",
    "catalog:verify": "pnpm --filter web catalog:verify",
    "catalog:apply": "pnpm --filter web catalog:apply",
    "start": "turbo run start",
    "db:migrate": "turbo run db:migrate",
    "check:client-bundle": "turbo run check:client-bundle"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "turbo": "2.11.8"
  }
}
