{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "**",
      "!apps/web/public/assets",
      "!apps/web/src/app/icon.svg",
      "!apps/web/src/content/*.json",
      "!package-lock.json",
      "!**/playwright-report",
      "!**/test-results",
      "!**/coverage",
      "!**/.next",
      "!**/.open-next",
      "!**/next-env.d.ts",
      "!apps/web/src/locales/*/messages.ts",
      "!.vscode",
      "!.claude",
      "!.vercel",
      "!docs/design/mockups",
      "!apps/web/scripts/catalog/.cache",
      "!apps/web/scripts/catalog/out",
      "!**/.turbo"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "warn",
          "options": {
            "maxAllowedComplexity": 15
          }
        },
        "noExcessiveLinesPerFunction": {
          "level": "warn",
          "options": {
            "maxLines": 60,
            "skipBlankLines": true
          }
        },
        "noForEach": "warn",
        "noUselessTernary": "error",
        "noImportantStyles": "off"
      },
      "style": {
        "noNestedTernary": "error",
        "useBlockStatements": "error",
        "noParameterAssign": "error",
        "noNonNullAssertion": "error",
        "noUselessElse": "error",
        "useCollapsedElseIf": "error",
        "useConst": "error",
        "useTemplate": "error",
        "useSingleVarDeclarator": "error",
        "useConsistentArrayType": "error",
        "noDescendingSpecificity": "off"
      },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "noUnusedFunctionParameters": "warn",
        "useExhaustiveDependencies": "error",
        "useHookAtTopLevel": "error"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noShadow": "warn",
        "noConsole": {
          "level": "warn",
          "options": {
            "allow": ["error", "warn"]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["apps/web/scripts/**", "**/*.config.*"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": [
        "apps/web/src/game/**",
        "apps/web/src/components/**",
        "apps/web/src/screens/**",
        "apps/web/src/hooks/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "effect": "Effect is server-only. Keep it under src/server so it stays out of the client bundle."
                },
                "patterns": [
                  {
                    "group": ["effect/**", "@effect/**"],
                    "message": "Effect is server-only. Keep it under src/server so it stays out of the client bundle."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/*.test.*", "src/test/**"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveLinesPerFunction": "off"
          }
        }
      }
    }
  ],
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
