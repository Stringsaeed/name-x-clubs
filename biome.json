{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "**",
      "!public/assets",
      "!src/app/icon.svg",
      "!src/content/*.json",
      "!package-lock.json",
      "!playwright-report",
      "!test-results",
      "!coverage",
      "!.next",
      "!.open-next",
      "!next-env.d.ts",
      "!src/locales/*/messages.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "warn",
          "options": { "maxAllowedComplexity": 15 }
        },
        "noExcessiveLinesPerFunction": {
          "level": "warn",
          "options": { "maxLines": 60, "skipBlankLines": true }
        },
        "noForEach": "warn",
        "noUselessTernary": "error",
        "noImportantStyles": "off"
      },
      "style": {
        "noNestedTernary": "error",
        "useBlockStatements": "error",
        "noParameterAssign": "error",
        "noNonNullAssertion": "error",
        "noUselessElse": "error",
        "useCollapsedElseIf": "error",
        "useConst": "error",
        "useTemplate": "error",
        "useSingleVarDeclarator": "error",
        "useConsistentArrayType": "error",
        "noDescendingSpecificity": "off"
      },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "noUnusedFunctionParameters": "warn",
        "useExhaustiveDependencies": "error",
        "useHookAtTopLevel": "error"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noShadow": "warn",
        "noConsole": { "level": "warn", "options": { "allow": ["error", "warn"] } }
      }
    }
  },
  "overrides": [
    {
      "includes": ["scripts/**", "**/*.config.*"],
      "linter": { "rules": { "suspicious": { "noConsole": "off" } } }
    },
    {
      "includes": ["**/*.test.*", "src/test/**"],
      "linter": { "rules": { "complexity": { "noExcessiveLinesPerFunction": "off" } } }
    }
  ],
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
